    "idea_name": { "type": "string" },
    "title": { "type": "string" },
    "description": { "type": "string" },
    "literature_top_k": { "type": "integer", "minimum": 1 },
    "rubric_profile": { "type": "string", "enum": ["default", "cvpr", "journal_q2"] },
